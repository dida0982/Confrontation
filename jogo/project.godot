; Arquivo de configuração do projeto Godot.
; Normalmente é editado pelo menu Projeto > Configurações do Projeto.

config_version=5

[application]

config/name="Confrontation"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Controles="*res://scripts/autoload/controles.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[layer_names]

3d_physics/layer_1="mundo"
3d_physics/layer_2="jogadores"
3d_physics/layer_3="hitbox"

[physics]

common/physics_ticks_per_second=128
3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="forward_plus"
